# AI Nurse System Environment Variables
APP_ENV=development
SECRET_KEY=change-this-secret-key-to-something-secure-in-production

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
STT_PROVIDER=openai_whisper
LLM_PROVIDER=openai_gpt4o
TRANSLATION_PROVIDER=openai
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_nurse.db

# Rules Engine
TRIAGE_RULES_VERSION=1.0.0
TRIAGE_RULES_DIR=./app/rules

# Security
ALLOWED_HOSTS=["*"]
RATE_LIMIT_PER_MINUTE=60
